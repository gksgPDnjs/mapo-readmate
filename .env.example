# Local team development database started by `npm run db:dev:up`.
DATABASE_URL=postgresql://mapo_readmate:mapo_readmate@localhost:5432/mapo_readmate

# For a shared Supabase database, replace DATABASE_URL with the URI from
# Supabase Dashboard > Project Settings > Database > Connection string (URI).

# https://www.nl.go.kr/NL/contents/N31101020000.do 에서 신청한 인증키
NATIONAL_LIBRARY_CERT_KEY=issued-api-key

# Server-only catalog API keys. Never use a VITE_ prefix for these values.
ALADIN_TTB_KEY=
GOOGLE_BOOKS_API_KEY=
DATA4LIBRARY_API_KEY=

# Optional. The API uses this only to explain database-selected books.
GEMINI_API_KEY=
API_PORT=3001