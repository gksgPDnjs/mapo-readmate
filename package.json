{
  "name": "mapo-readmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:dev": "tsx watch src/api/server.ts",
    "api:start": "tsx src/api/server.ts",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "npm run api:start",
    "catalog:sync:data4library": "tsx scripts/sync-data4library-loans.ts",
    "catalog:sync:nl": "tsx scripts/sync-national-library.ts",
    "catalog:sync:openlibrary": "tsx scripts/sync-open-library-bulk.ts",
    "catalog:publish:openlibrary": "tsx scripts/publish-open-library-mvp-catalog.ts",
    "catalog:check:500": "tsx scripts/check-catalog-volume.ts",
    "catalog:unpublish:openlibrary": "tsx scripts/unpublish-open-library-catalog.ts",
    "db:check": "tsx scripts/validate-db-contract.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-development-catalog.ts",
    "db:seed-features": "tsx scripts/seed-feature-taxonomy.ts",
    "db:seed-features:check": "tsx scripts/seed-feature-taxonomy.ts --check",
    "demo:check": "tsx scripts/check-demo-flow.ts",
    "integrations:check": "tsx scripts/check-external-book-apis.ts",
    "mcp:books": "tsx src/mcp/book-catalog-server.ts",
    "mcp:check": "tsx scripts/check-mcp-book-tools.ts",
    "recommendations:check": "tsx scripts/check-recommendation-flow.ts",
    "trait-coverage:check": "tsx scripts/check-trait-coverage.ts",
    "validation:run": "tsx scripts/run-validation-harness.ts",
    "db:dev:up": "docker compose up --detach --wait db && tsx scripts/bootstrap-development-db.ts",
    "db:dev:down": "docker compose down",
    "db:dev:reset": "docker compose down --volumes && npm run db:dev:up",
    "typecheck": "tsc --noEmit",
    "test": "npm run db:check && npm run typecheck"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.11.2",
    "openai": "^7.4.0",
    "postgres": "^3.4.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
