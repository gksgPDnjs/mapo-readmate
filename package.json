{
  "name": "mapo-readmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:dev": "tsx watch src/api/server.ts",
    "api:start": "tsx src/api/server.ts",
    "catalog:sync:data4library": "tsx scripts/sync-data4library-loans.ts",
    "catalog:sync:nl": "tsx scripts/sync-national-library.ts",
    "catalog:sync:openlibrary": "tsx scripts/sync-open-library-bulk.ts",
    "catalog:check:500": "tsx scripts/check-catalog-volume.ts",
    "db:check": "tsx scripts/validate-db-contract.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-development-catalog.ts",
    "db:seed-features": "tsx scripts/seed-feature-taxonomy.ts",
    "db:seed-features:check": "tsx scripts/seed-feature-taxonomy.ts --check",
    "integrations:check": "tsx scripts/check-external-book-apis.ts",
    "recommendations:check": "tsx scripts/check-recommendation-flow.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run db:check && npm run typecheck"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.11.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
